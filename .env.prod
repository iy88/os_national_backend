FLASK_ENV=production
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=os_national
MYSQL_PASSWORD=your_secure_production_password
MYSQL_DATABASE=os_national

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password

# JWT
JWT_SECRET=YOUR_CRITICAL_PRODUCTION_JWT_SECRET_MUST_BE_RANDOM_AND_SECURE
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# SMTP 邮件服务
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=your_secure_smtp授权码
SMTP_SENDER=OS National <noreply@example.com>

# 文件上传
UPLOAD_FOLDER=uploads/files
MAX_AVATAR_SIZE=2097152

# AI Provider
AI_PROVIDER=dashscope
AI_API_KEY=your_api_key_here
AI_APP_ID=your_app_id_here
AI_TITLE_MODEL=qwen3.5-plus
