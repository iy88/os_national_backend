FLASK_ENV=production
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=os_national
MYSQL_PASSWORD=your_secure_production_password
MYSQL_DATABASE=os_national

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password

# JWT
JWT_SECRET=YOUR_CRITICAL_PRODUCTION_JWT_SECRET_MUST_BE_RANDOM_AND_SECURE
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# SMTP 邮件服务
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=your_secure_smtp授权码
SMTP_SENDER=noreply@example.com
SMTP_SENDER_NAME=城竞共生

# 文件上传
UPLOAD_FOLDER=uploads/files
MAX_AVATAR_SIZE=2097152

# AI Provider
AI_PROVIDER=tencent_adp
AI_API_KEY=your_api_key_here
ROUTE_APP_ID=your_app_id_here
AI_TITLE_MODEL=minimax-m2.5

# Roleplay App IDs
ROLEPLAY_APP_ID_GAME_EXPERT=your_game_expert_app_id_here
ROLEPLAY_APP_ID_ESPORTS_PLAYER=your_esports_player_app_id_here
ROLEPLAY_APP_ID_GAME_HERO=your_game_hero_app_id_here

# === Tencent Yuanqi (腾讯元器) ===
# 切换 AI_PROVIDER=tencent_yuanqi 时启用以下 4 对 (app_id, app_key)
# 每个智能体在腾讯元器控制台单独配置，URL: https://yuanqi.tencent.com/openapi/v1/agent/chat/completions

# 1 个路线规划 agent
YUANQI_ROUTE_APP_KEY=
YUANQI_ROUTE_APP_ID=

# 3 个角色扮演 agent
YUANQI_APP_KEY_GAME_EXPERT=
YUANQI_APP_ID_GAME_EXPERT=
YUANQI_APP_KEY_ESPORTS_PLAYER=
YUANQI_APP_ID_ESPORTS_PLAYER=
YUANQI_APP_KEY_GAME_HERO=
YUANQI_APP_ID_GAME_HERO=
