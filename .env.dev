FLASK_ENV=development
FLASK_DEBUG=true
HOST=0.0.0.0
PORT=5000

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=os_national

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_dev_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# SMTP 邮件服务
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=your_smtp授权码
SMTP_SENDER=noreply@example.com
SMTP_SENDER_NAME=城竞共生

# 文件上传
UPLOAD_FOLDER=uploads/files
MAX_AVATAR_SIZE=2097152

# AI Provider
AI_PROVIDER=dashscope
AI_API_KEY=your_api_key_here
AI_APP_ID=your_app_id_here
AI_TITLE_MODEL=qwen3.5-plus

# Roleplay App IDs
ROLEPLAY_APP_ID_GAME_EXPERT=your_game_expert_app_id_here
ROLEPLAY_APP_ID_ESPORTS_PLAYER=your_esports_player_app_id_here
ROLEPLAY_APP_ID_GAME_HERO=your_game_hero_app_id_here
