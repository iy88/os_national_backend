FLASK_ENV=development
FLASK_DEBUG=true
HOST=0.0.0.0
PORT=5000

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=os_national

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_dev_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# SMTP 邮件服务
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=your_smtp授权码
SMTP_SENDER=OS National <noreply@example.com>
